# ==========================================
# Konfigurasi Port & Host Aplikasi
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Konfigurasi Database PostgreSQL
# ==========================================
# Host server PostgreSQL (gunakan 'db' jika menggunakan docker-compose, atau 'localhost' untuk lokal)
PGHOST=localhost
PGPORT=5432
PGDATABASE=pembekalan_db
PGUSER=postgres
PGPASSWORD=postgrespassword

# Atau gunakan connection string DATABASE_URL (opsional):
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/pembekalan_db

# ==========================================
# Keamanan & Autentikasi
# ==========================================
JWT_SECRET=supersecret_jwt_key_pembekalan_2025
EXTERNAL_API_KEY=external_secret_token_12345

# ==========================================
# Google AI Studio Defaults (bawaan platform)
# ==========================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
